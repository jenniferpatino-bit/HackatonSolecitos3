# API de Lumon
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Storage: SUPABASE o CLOUDINARY (solo valores públicos)
VITE_STORAGE_PROVIDER=

# Supabase: URL del proyecto y clave publicable (anon / sb_publishable_...). Nunca la secreta.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_BUCKET=

# Cloudinary: cloud name y preset unsigned. Nunca el API secret.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
